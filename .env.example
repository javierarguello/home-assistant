# =============================================================================
#  home-assistant — configuration
#  Copy to `.env` and edit. Everything that changes between "all-local on the
#  Raspberry Pi" and "cloud" lives here — no code changes needed.
# =============================================================================

ASSISTANT_NAME=Asistente
ASSISTANT_LANGUAGE=es

# Run mode if --mode is not passed: chat | voice
MODE=chat

# Kiosk WebSocket server
WS_PORT=8787
WS_ENABLED=true

# Diagnostics log (default: <repo>/logs/agent.log)
# LOG_DIR=/var/log/home-assistant
LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  LLM — any OpenAI-compatible endpoint. Pick ONE profile below (or mix per
#  agent, see "Per-agent overrides"). The default is local Ollama.
# -----------------------------------------------------------------------------

# --- Profile A: LOCAL (Ollama on the Pi) -------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=512

# --- Profile B: GEMINI (cloud, OpenAI-compatible — cheapest way to test) -----
# Get a key at https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...your-gemini-key...
# LLM_MODEL=gemini-2.5-flash-lite

# --- Profile C: OPENAI (cloud) -----------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...your-openai-key...
# LLM_MODEL=gpt-4o-mini

# --- Profile D: VERTEX AI via gcloud CLI (no static key) ---------------------
# Uses your already-authenticated gcloud login to mint a bearer token per call.
# Requires: gcloud installed + authenticated, and the Vertex AI API enabled on
# the project (gcloud services enable aiplatform.googleapis.com).
# LLM_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<PROJECT_ID>/locations/global/endpoints/openapi
# LLM_AUTH=gcloud
# LLM_GCLOUD_ACCOUNT=you@example.com
# LLM_MODEL=google/gemini-2.5-flash-lite

# --- Per-agent overrides -----------------------------------------------------
# Each agent reads <AGENT>_MODEL/<AGENT>_BASE_URL/<AGENT>_API_KEY, falling back
# to the LLM_* defaults above. Agents: ROOT, WEB_SEARCH.
# Example: keep the orchestrator local, but use a stronger cloud model to search.
# WEB_SEARCH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# WEB_SEARCH_API_KEY=AIza...
# WEB_SEARCH_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
#  TOOLS
# -----------------------------------------------------------------------------
# Optional: better web search than the keyless DuckDuckGo fallback.
# TAVILY_API_KEY=tvly-...


# -----------------------------------------------------------------------------
#  SPEECH — only used in voice mode (--mode=voice)
# -----------------------------------------------------------------------------

# Wake word engine: openwakeword (local, no key — default) | porcupine
WAKE_WORD_ENGINE=openwakeword
# openWakeWord: model name (hey_jarvis, alexa, hey_mycroft…) or path to a custom .onnx
WAKE_WORD=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
# Set by scripts/setup-pi.sh; override if needed:
# WAKEWORD_PYTHON=vendor/wakeword-venv/bin/python
# WAKEWORD_SCRIPT=apps/agent/python/wakeword_runner.py
# WAKEWORD_INPUT_DEVICE=          # sounddevice device index/name (default: system default)
#
# Porcupine alternative (needs a key + periodic internet for license validation):
# WAKE_WORD_ENGINE=porcupine
# PICOVOICE_ACCESS_KEY=
# WAKE_WORD=computer
# WAKE_WORD_SENSITIVITY=0.5

# Speech-to-text: whisper-server (recommended) | whisper-local | openai | mock
#   whisper-server keeps the model in memory (fast every turn) and auto-starts.
#   whisper-local spawns whisper-cli per utterance (reloads the model each time).
STT_PROVIDER=whisper-server
# Transcription language; 'auto' detects it (multilingual — replies match input language)
STT_LANGUAGE=auto
WHISPER_BINARY=whisper-cli
WHISPER_SERVER_BINARY=whisper-server
WHISPER_MODEL=models/ggml-base.bin
WHISPER_THREADS=4
WHISPER_SERVER_URL=http://127.0.0.1:8088
WHISPER_SERVER_AUTOSTART=true
# Cloud STT (when STT_PROVIDER=openai)
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1

# Text-to-speech: piper | openai | mock
TTS_PROVIDER=piper
PIPER_BINARY=piper
PIPER_VOICE=voices/es_AR-daniela-high.onnx
# English voice — used automatically when the reply is detected as English
TTS_VOICE_EN=voices/en_US-amy-medium.onnx
# Cloud TTS (when TTS_PROVIDER=openai)
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=sk-...
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Audio playback command (auto: afplay on macOS, aplay on Linux/Pi)
# AUDIO_PLAYER=aplay
